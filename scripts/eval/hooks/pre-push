#!/usr/bin/env bash
# eval-harness git pre-push hook.
# Settled Decision #3 (v2): pre-push, NOT pre-commit. Fire-rate economics.
# Triggers eval for skills whose files are part of the push.
# Sync, 60s timeout, warn-only by default (use `eval-harness promote` to enable blocking).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"
if [[ ! -f "$LIB_DIR/config.sh" ]]; then
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  LIB_DIR="$REPO_ROOT/scripts/eval/lib"
fi
if [[ ! -f "$LIB_DIR/config.sh" ]]; then
  echo "[eval-harness] pre-push: eval-harness libraries not found" >&2
  exit 13
fi
source "$LIB_DIR/yq-shim.sh"
source "$LIB_DIR/skills_root.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/portable.sh"

REMOTE="${1:-origin}"
URL="${2:-}"

# Read pushed refs from stdin (git pre-push contract)
affected_skills=()
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  branch=""
  case "$local_ref" in refs/heads/*) branch="${local_ref#refs/heads/}" ;; esac
  if [[ -n "$branch" ]] && ! pre_push_should_fire "$branch"; then
    echo "[eval-harness] pre-push: skipping branch '$branch' (filtered by pre_push.branches config)" >&2
    continue
  fi
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    changed_files="$(git diff --name-only "$local_sha" 2>/dev/null || true)"
  else
    changed_files="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
  fi
  while IFS= read -r f; do
    case "$f" in
      .opencode/skills/*/*|*/.opencode/skills/*/*)
        skill_path="${f#*.opencode/skills/}"
        skill="${skill_path%%/*}"
        [[ -n "$skill" ]] && affected_skills+=("$skill")
        ;;
    esac
  done <<< "$changed_files"
done

if [[ ${#affected_skills[@]} -eq 0 ]]; then
  exit 0
fi

unique_skills="$(printf '%s\n' "${affected_skills[@]}" | sort -u)"
echo "[eval-harness] pre-push: detected skill changes" >&2
echo "$unique_skills" | sed 's/^/  - /' >&2

EVAL_HARNESS_BIN="${EVAL_HARNESS_BIN:-eval-harness}"
exit_code=0
for skill in $unique_skills; do
  if run_with_timeout 60 "$EVAL_HARNESS_BIN" --skill="$skill" --trigger=pre-push; then
    :
  else
    run_rc=$?
    if [[ "$exit_code" -eq 0 ]]; then exit_code="$run_rc"; fi
  fi
done

exit "$exit_code"
