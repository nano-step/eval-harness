{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atd.mutation-plan/v1",
  "title": "Autonomous Test Discovery scoped Stryker plan",
  "description": "Produced by scripts/eval/discovery/mutation.mjs. strykerConfig is written verbatim as stryker.config.json. The plan is only ever executed inside the confined atd-sandbox; hostExecution is always forbidden.",
  "type": "object",
  "required": ["schema", "baseCommit", "candidateCommit", "diffSha256", "scope", "seed", "maxMutants", "env", "framework", "tests", "files", "strykerConfig", "configSha256", "reportPath", "argv", "requiresConfinement", "hostExecution"],
  "properties": {
    "schema": { "const": "atd.mutation-plan/v1" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diffSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope": { "enum": ["hunks", "symbols"] },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "maxMutants": { "type": "integer", "minimum": 1, "maximum": 500 },
    "env": {
      "type": "object",
      "required": ["ATD_SEED", "FC_SEED"],
      "properties": {
        "ATD_SEED": { "type": "string", "pattern": "^[0-9]{1,10}$" },
        "FC_SEED": { "type": "string", "pattern": "^[0-9]{1,10}$" }
      }
    },
    "framework": { "enum": ["vitest", "node:test"] },
    "tests": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "symbols", "ranges"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "symbols": { "type": "array", "items": { "type": "string" } },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["startLine", "endLine"],
              "properties": {
                "startLine": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "strykerConfig": {
      "type": "object",
      "required": ["mutate", "testRunner", "inPlace", "reporters", "jsonReporter"],
      "properties": {
        "mutate": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_@+./-]+:[0-9]+-[0-9]+$" } },
        "testRunner": { "enum": ["vitest", "command"] },
        "inPlace": { "const": false },
        "reporters": { "type": "array", "items": { "type": "string" } },
        "jsonReporter": { "type": "object", "required": ["fileName"], "properties": { "fileName": { "type": "string" } } }
      }
    },
    "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reportPath": { "type": "string", "minLength": 1 },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiresConfinement": { "const": true },
    "hostExecution": { "const": "forbidden" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
